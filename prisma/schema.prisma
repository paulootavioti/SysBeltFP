  telefoneE164 String
  email        String?

  tipoContato          TipoContatoLead @default(PRATICANTE)
  praticanteNome       String?
  praticanteNascimento DateTime?
  situacao             SituacaoLead    @default(NUNCA_TREINOU)
  turnoPreferido       String[]        @default([])

  modalidadeInteresseId Int?
  modalidadeInteresse   Modalidade? @relation(fields: [modalidadeInteresseId], references: [id])

  canalId Int
  canal   CanalCaptacao @relation(fields: [canalId], references: [id])

  campanhaId Int?
  campanha   Evento? @relation(fields: [campanhaId], references: [id])

  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  referrer    String?

  estagio EstagioLead @default(NOVO)

  responsavelUsuarioId Int?
  responsavelUsuario   Usuario? @relation("LeadResponsavel", fields: [responsavelUsuarioId], references: [id])

  proximaAcaoEm DateTime?
  motivoPerda   String?

  alunoId Int?
  aluno   Aluno? @relation(fields: [alunoId], references: [id])

  observacoes    String?
  eventos        LeadEvento[]
  consentimentos LeadConsentimento[]

  criadoEm            DateTime             @default(now())
  atualizadoEm        DateTime             @default(now()) @updatedAt
  conversaMensagerias ConversaMensageria[]

  @@unique([unidadeId, telefoneE164])
  @@index([telefoneE164])
  @@index([unidadeId, estagio, proximaAcaoEm])
  @@index([canalId, criadoEm])
  @@index([campanhaId, criadoEm])
}

model CanalCaptacao {
  id Int @id @default(autoincrement())

  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  nome  String
  slug  String  @unique
  ativo Boolean @default(true)

  leads            Lead[]
  canaisMensageria CanalMensageria[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt

  @@unique([unidadeId, nome])
  @@index([unidadeId, ativo])
}

model CanalMensageria {
  id                   Int                       @id @default(autoincrement())
  unidadeId            Int
  unidade              Unidade                   @relation(fields: [unidadeId], references: [id])
  tipo                 TipoCanalMensageria
  identificadorExterno String
  businessAccountId    String?
  nomeExibicao         String
  tokenRef             String
  verifyTokenRef       String
  canalCaptacaoId      Int?
  canalCaptacao        CanalCaptacao?            @relation(fields: [canalCaptacaoId], references: [id])
  ativo                Boolean                   @default(true)
  statusConexao        StatusConexaoMensageria   @default(PENDENTE)
  codigoErroConexao    String?
  validadoEm           DateTime?
  sincronizadoEm       DateTime?
  tokenExpiraEm        DateTime?
  proximaRenovacaoEm   DateTime?
  ultimoDiagnosticoEm  DateTime?
  tokenVersao          Int                       @default(1)
  conversas            ConversaMensageria[]
  mensagens            MensagemMensageria[]
  templates            TemplateMensageria[]
  eventosEntrada       EventoMensageriaEntrada[]
  consentimentosLead   LeadConsentimento[]
  criadoEm             DateTime                  @default(now())
  atualizadoEm         DateTime                  @default(now()) @updatedAt

  @@unique([tipo, identificadorExterno])
  @@index([unidadeId, ativo])
