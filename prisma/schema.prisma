// Token de uso único para recuperação de acesso. O valor enviado por e-mail
// nunca é persistido: somente o SHA-256 fica no banco. `alvos` guarda os ids
// das identidades que terão a senha atualizada (um Usuario ou as identidades
// familiares que compartilham o mesmo e-mail).
model TokenRedefinicaoSenha {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  tipo      String
  email     String
  alvos     Json
  expiraEm  DateTime
