// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AulaStatus {
  ABERTA
  FINALIZADA
}

enum TipoBlocoAulaCurriculo {
  AQUECIMENTO
  JOGO
  TECNICA
  SPARRING
  PAUSA
  ALONGAMENTO
}

enum StatusExecucaoBlocoAula {
  CUMPRIDO
  PULADO
}

enum AcaoComandoVoz {
  INICIAR
  PAUSAR
  AVANCAR
  CONSULTAR
  BLOCO_PAUSA
}

// O frontend hoje calcula um status equivalente no cliente
// (mensalidades/utils/status.ts) usando o rótulo "PENDENTE" pra
// "ainda não paga, dentro do prazo" — aqui esse mesmo estado se chama
// ABERTA (nome mais preciso pro dado agora persistido no banco); o
// frontend passa a mapear ABERTA -> "PENDENTE" na exibição, sem quebrar a
// UI existente.
enum StatusMensalidade {
  ABERTA
  PAGA
  VENCIDA
  CANCELADA
  ESTORNADA
}

// Os 10 tipos pedidos pelo produto + OUTRO (forma configurável pelo
// administrador, com nome livre em FormaPagamento.nomePersonalizado).
enum TipoFormaPagamento {
  PIX
  PIX_RECORRENTE
  CARTAO_CREDITO_VISTA
  CARTAO_CREDITO_PARCELADO
  CARTAO_CREDITO_RECORRENTE
  CARTAO_DEBITO
  TRANSFERENCIA
  DINHEIRO
  BOLETO
  LINK_PAGAMENTO
  OUTRO
}

enum StatusAssinatura {
  ATIVA
  PAUSADA
  CANCELADA
  CONCLUIDA
}

// Os 8 estados pedidos pelo produto para o ciclo de vida do contrato.
enum SituacaoContrato {
  RASCUNHO
  PENDENTE_ASSINATURA
  ASSINADO
  ATIVO
  SUSPENSO
  CANCELADO
  ENCERRADO
  RENOVADO
}

enum TipoAssinaturaContrato {
  DIGITAL
  ELETRONICA
  PRESENCIAL
}

// Categorias fixas do catálogo da loja — lista fechada pedida pelo produto.
enum CategoriaProduto {
  KIMONO
  RASHGUARD
  BERMUDA
  FAIXA
  PATCH
  CHAVEIRO
  PULSEIRA
  OUTROS
}

enum TipoMovimentacaoEstoque {
  ENTRADA
  SAIDA
}

// O CLIENTE do SysBelt — a empresa que assina a plataforma. É o topo da
// hierarquia: uma Conta tem uma ou mais Unidades (as filiais da academia).
//
// A distinção que importa: `Unidade` sempre existiu pra separar filiais da
// MESMA academia; `Conta` separa academias DIFERENTES, que não podem se
// enxergar. Quem escreve consulta nova filtra por unidade como sempre — a
// fronteira entre clientes é resolvida em `escopoUnidade`, num lugar só.
model Conta {
  id Int @id @default(autoincrement())

  tenantKey     String  @unique @default(uuid()) @db.Uuid
  nome          String
  documento     String? // CNPJ ou CPF do assinante
  emailCobranca String?

  ativo Boolean @default(true)

  unidades    Unidade[]
  assinatura  AssinaturaPlataforma?
  concessao   ConcessaoPlataforma?
  faturas     FaturaPlataforma[]
  comandosVoz ComandoVoz[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// ATENÇÃO: `Plano`, `Assinatura` e `Mensalidade` (mais abaixo) são o
// financeiro DA ACADEMIA — o que o aluno paga pra treinar. Os três modelos
// abaixo, com sufixo `Plataforma`, são a outra ponta: o que a academia paga
// pro SysBelt. São domínios distintos e não devem se misturar.

// Catálogo de planos de assinatura da plataforma. O preço é por faixa de
// alunos: a cada `alunosPorBloco` alunos ativos, cobra-se
// `precoPorBlocoCentavos` — 50 alunos em blocos de 10 a R$ 37,00 dão
// 5 × 3700 = R$ 185,00. Assim o preço acompanha o tamanho do assinante.
model PlanoPlataforma {
  id Int @id @default(autoincrement())

  nome      String  @unique
  descricao String?

  alunosPorBloco        Int
  // Dinheiro aqui é INTEIRO em centavos, ao contrário do financeiro da
  // academia (que usa Float). Este valor é faturado e conciliado com o
  // gateway: centavo que "some" numa soma de ponto flutuante vira
  // divergência de caixa. R$ 37,00 = 3700.
  precoPorBlocoCentavos Int
  // Piso da fatura. Com 1, um assinante ativo sem nenhum aluno cadastrado
  // paga um bloco; com 0, pagaria zero. Ver comentário em precoPlataforma.ts.
  blocosMinimos         Int @default(1)

  // O que este plano libera. Recursos conhecidos em
  // src/modules/plataforma/utils/recursosDoPlano.ts.
  recursos String[] @default([])

  ativo Boolean @default(true)

  assinaturas AssinaturaPlataforma[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

enum StatusAssinaturaPlataforma {
  TESTE
  ATIVA
  INADIMPLENTE
  SUSPENSA
  CANCELADA
}

// A assinatura da Conta na plataforma. Uma por conta (`contaId` é único).
model AssinaturaPlataforma {
  id Int @id @default(autoincrement())

  contaId Int   @unique
  conta   Conta @relation(fields: [contaId], references: [id])

  planoId Int
  plano   PlanoPlataforma @relation(fields: [planoId], references: [id])

  status StatusAssinaturaPlataforma @default(TESTE)

  // Preço negociado: quando preenchido, substitui o do plano. É o que
  // permite fechar condição especial com um assinante grande sem criar um
  // plano só pra ele.
  precoPorBlocoCentavos Int?

  diaVencimento Int @default(10)

  inicioEm    DateTime  @default(now())
  fimTesteEm  DateTime?
  canceladaEm DateTime?

  faturas FaturaPlataforma[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

enum StatusFaturaPlataforma {
  ABERTA
  PAGA
  CANCELADA
}

enum StatusAcessoPlataforma {
  ATIVO
  SUSPENSO
  CANCELADO
}

// Projeção local assinada pelo Control Plane. Não possui relação com as
// tabelas comerciais legadas e contém somente o necessário para autorizar
// recursos da Conta correspondente no banco operacional compartilhado.
model ConcessaoPlataforma {
  id               Int                    @id @default(autoincrement())
  contaId          Int                    @unique
  conta            Conta                  @relation(fields: [contaId], references: [id])
  tenantKey        String                 @unique @db.Uuid
  statusAcesso     StatusAcessoPlataforma
  recursos         String[]
  versaoContrato   Int
  revisao          Int
  emitidaEm        DateTime
  expiraEm         DateTime
  sincronizadaEm   DateTime               @default(now())
  payloadHash      String
  assinaturaBase64 String
}

// Fatura mensal da plataforma. Guarda a contagem de alunos e o preço
// USADOS no fechamento — mudar o plano depois não reescreve o que já foi
// cobrado.
model FaturaPlataforma {
  id Int @id @default(autoincrement())

  contaId Int
  conta   Conta @relation(fields: [contaId], references: [id])

  assinaturaId Int
  assinatura   AssinaturaPlataforma @relation(fields: [assinaturaId], references: [id])

  // Mês de referência, sempre no dia 1 à meia-noite UTC — data de
  // calendário, não instante (ver src/shared/utils/dataCalendario.ts).
  competencia DateTime
  vencimento  DateTime

  alunosContados        Int
  alunosPorBloco        Int
  blocos                Int
  precoPorBlocoCentavos Int
  valorCentavos         Int
  // Memória de cálculo por filial no momento do fechamento. É JSON porque
  // representa o retrato imutável da fatura, não uma relação viva que deve
  // mudar quando a unidade for renomeada ou desativada depois.
  detalhamentoUnidades  Json?

  status StatusFaturaPlataforma @default(ABERTA)
  pagaEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Trava de idempotência: a fatura identifica o FATO "competência X da
  // assinatura Y", não a tentativa de gerá-la. Rodar o fechamento duas
  // vezes no mesmo mês não cobra o assinante duas vezes.
  @@unique([assinaturaId, competencia])
}

model Unidade {
  id Int @id @default(autoincrement())

  contaId Int
  conta   Conta @relation(fields: [contaId], references: [id])

  nome  String
  ativo Boolean @default(true)

  landingSlug           String?  @unique
  landingPublicada      Boolean  @default(false)
  landingNome           String?
  landingDescricao      String?
  landingEndereco       String?
  landingCidade         String?
  landingUf             String?
  landingCep            String?
  landingTelefone       String?
  landingWhatsapp       String?
  landingHorario        String?
  landingFotoCapaUrl    String?
  landingDominio        String?

  arenas                 Arena[]
  modalidades            Modalidade[]
  usuarios               Usuario[]
  alunos                 Aluno[]
  alunosAutorizados      AlunoUnidade[]
  responsaveis           Responsavel[]
  turmas                 Turma[]
  planos                 Plano[]
  curriculos             Curriculo[]
  tecnicas               Tecnica[]
  competicoes            Competicao[]
  mensalidades           Mensalidade[]
  graduacoes             Graduacao[]
  aulasProgramadas       AulaProgramada[]
  aulas                  Aula[]
  vinculosUsuarios       UsuarioUnidade[]
  metas                  Meta[]
  eventos                Evento[]
  formasPagamento        FormaPagamento[]
  auditLogs              AuditLog[]
  assinaturas            Assinatura[]
  modelosContrato        ModeloContrato[]
  contratos              Contrato[]
  mensagensFamilia       MensagemFamilia[]
  produtos               Produto[]
  pedidos                Pedido[]
  leads                  Lead[]
  canaisCaptacao         CanalCaptacao[]
  eventosLead            LeadEvento[]
  consentimentos         Consentimento[]
  mensagensWhatsapp      MensagemWhatsapp[]
  cobrancasPagamento     CobrancaPagamento[]
  solicitacoesAssinatura SolicitacaoAssinatura[]
  canaisMensageria       CanalMensageria[]
  conversasMensageria    ConversaMensageria[]
  templatesMensageria    TemplateMensageria[]
  fluxosBot              BotFluxo[]

  createdAt DateTime @default(now())

  dispositivosAcesso DispositivoAcesso[]
  eventosAcesso      EventoAcesso[]
  importacoesAlunos  ImportacaoAlunos[]
}

// qualquer sala, tatame ou área usada pra ministrar aulas — uma unidade
// tem uma ou mais arenas.
model Arena {
  id Int @id @default(autoincrement())

  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  nome  String
  ativo Boolean @default(true)

  turmas        Turma[]
  pareamentoVoz PareamentoVozArena?

  createdAt DateTime @default(now())
}

model ComandoVoz {
  id                    Int                @id @default(autoincrement())
  contaId               Int
  conta                 Conta              @relation(fields: [contaId], references: [id], onDelete: Cascade)
  gatilho               String
  resposta              String
  acao                  AcaoComandoVoz
  duracaoBlocoSegundos  Int?
  avisoAntesFimSegundos Int?
  doSistema             Boolean            @default(false)
  ativo                 Boolean            @default(true)
  eventos               EventoComandoVoz[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @default(now()) @updatedAt

  @@unique([contaId, gatilho])
  @@index([contaId, ativo])
}

model PareamentoVozArena {
  id                  Int                @id @default(autoincrement())
  arenaId             Int                @unique
  arena               Arena              @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  tokenHash           String             @unique
  versaoConsentimento String
  textoConsentimento  String
  consentidoPorId     Int
  consentidoPor       Usuario            @relation(fields: [consentidoPorId], references: [id])
  ip                  String?
  dispositivo         String?
  consentidoEm        DateTime           @default(now())
  revogadoEm          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @default(now()) @updatedAt
  eventos             EventoComandoVoz[]
}

model EventoComandoVoz {
  id                    Int                @id @default(autoincrement())
  pareamentoId          Int
  pareamento            PareamentoVozArena @relation(fields: [pareamentoId], references: [id], onDelete: Cascade)
  comandoId             Int
  comando               ComandoVoz         @relation(fields: [comandoId], references: [id], onDelete: Cascade)
  acao                  AcaoComandoVoz
  duracaoBlocoSegundos  Int?
  avisoAntesFimSegundos Int?
  consumidoEm           DateTime?
  createdAt             DateTime           @default(now())

  @@index([pareamentoId, consumidoEm, createdAt])
}

model Aluno {
  id Int @id @default(autoincrement())

  unidadeId          Int
  unidade            Unidade        @relation(fields: [unidadeId], references: [id])
  unidadesPermitidas AlunoUnidade[]

  nome           String
  apelido        String?
  dataNascimento DateTime

  sexo String?
  cpf  String?
  rg   String?

  telefone String?
  whatsapp String?
  email    String?

  // credencial do Portal da Família pra login direto do aluno (perfil
  // ALUNO) — mesma lógica de senhaPortal do Responsavel.
  senhaPortal String?

  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  uf          String?

  escola       String?
  serieEscolar String?
  turnoEscolar String?

  peso   Float?
  altura Float?

  tamanhoKimono String?
  marcaKimono   String?

  restricoesMedicas String?
  alergias          String?
  medicamentos      String?
  observacoes       String?

  fotoUrl String?

  faixa String  @default("Branca")
  grau  Int     @default(0)
  ativo Boolean @default(true)

  // consentimento de imagem — controla se fotos de treino em que o aluno
  // aparece podem ser marcadas como visíveis na landing pública (a
  // exibição privada no Portal da Família, restrita à própria família,
  // não depende disso).
  autorizaUsoImagem Boolean @default(true)

  responsaveis     Responsavel[]
  mensalidades     Mensalidade[]
  assinaturas      Assinatura[]
  graduacoes       Graduacao[]
  aulas            AulaAluno[]
  competicoes      CompeticaoAluno[]
  comportamentos   Comportamento[]
  contratos        Contrato[]
  mensagensFamilia MensagemFamilia[]
  pedidos          Pedido[]
  notasAula        NotaAula[]

  turmaId Int?
  turma   Turma? @relation(fields: [turmaId], references: [id])

  formaPagamento String?
  diaVencimento  Int?

  planoId Int?
  plano   Plano? @relation(fields: [planoId], references: [id])

  createdAt DateTime @default(now())
  //updatedAt         DateTime         @updatedAt
  updatedAt DateTime @default(now()) @updatedAt

  credenciaisAcesso   CredencialAcesso[]
  eventosAcesso       EventoAcesso[]
  consentimentos      Consentimento[]
  mensagensWhatsapp   MensagemWhatsapp[]
  importacaoLoteId    Int?
  importacaoLote      ImportacaoAlunos?    @relation(fields: [importacaoLoteId], references: [id])
  leads               Lead[]
  conversasMensageria ConversaMensageria[]
}

enum StatusImportacaoAlunos {
  CONFIRMADA
  DESFEITA
}

model ImportacaoAlunos {
  id Int @id @default(autoincrement())

  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  nomeArquivo       String
  hashArquivo       String
  totalLinhas       Int
  totalCriados      Int
  totalAtualizados  Int                    @default(0)
  totalIgnorados    Int                    @default(0)
  atualizacoesAntes Json?
  status            StatusImportacaoAlunos @default(CONFIRMADA)
  desfazivelAte     DateTime
  desfeitaEm        DateTime?

  alunos Aluno[]

  createdAt DateTime @default(now())

  @@index([unidadeId, createdAt])
}

// Unidades da mesma academia em que o aluno está autorizado a frequentar.
// A unidade principal também possui uma linha e nunca é inferida na cobrança.
model AlunoUnidade {
  alunoId   Int
  unidadeId Int

  aluno   Aluno   @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  unidade Unidade @relation(fields: [unidadeId], references: [id], onDelete: Cascade)

  criadoEm DateTime @default(now())

  @@id([alunoId, unidadeId])
  @@index([unidadeId, alunoId])
}

model Responsavel {
  id Int @id @default(autoincrement())

  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  nome    String
  apelido String?

  cpf            String?
  rg             String?
  dataNascimento DateTime?
  sexo           String?

  telefone String?
  whatsapp String?
  email    String?

  // credencial do Portal da Família — null enquanto o Admin não define uma
  // senha inicial (ver SetSenhaPortalResponsavelService); sem isso o
  // responsável não consegue logar no portal.
  senhaPortal String?

  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  uf          String?

  parentesco String @default("Não informado")

  responsavelFinanceiro Boolean @default(false)
  podeBuscar            Boolean @default(true)
  contatoEmergencia     Boolean @default(false)
  recebeComunicados     Boolean @default(true)

  observacoes String?
  fotoUrl     String?

  ativo Boolean @default(true)

  alunoId Int
  aluno   Aluno @relation(fields: [alunoId], references: [id])

  contratosComoContratante Contrato[]
  consentimentos           Consentimento[]
  mensagensWhatsapp        MensagemWhatsapp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// forma de pagamento configurável por unidade — habilita/desabilita os
// tipos suportados e guarda parâmetros específicos do gateway em
// `configuracao` (ex.: dias de compensação do boleto). `nomePersonalizado`
// só é usado quando `tipo === OUTRO`.
model FormaPagamento {
  id Int @id @default(autoincrement())

  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  tipo              TipoFormaPagamento
  nomePersonalizado String?
  ativo             Boolean            @default(true)
  configuracao      Json?

  mensalidades Mensalidade[]
  assinaturas  Assinatura[]
  contratos    Contrato[]
  cobrancas    CobrancaPagamento[]
  pedidos      Pedido[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// Auditoria genérica de alterações financeiras e contratuais — quem fez,
// quando, o que mudou. Reaproveitada por qualquer módulo de escrita
// sensível (hoje: Mensalidade; nas próximas fases: Contrato, Assinatura).
model AuditLog {
  id Int @id @default(autoincrement())

  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  // Nulo quando a operação não partiu de uma pessoa: webhook de gateway,
  // cron de geração de cobrança, script de manutenção. Antes isto fazia o
  // registro ser descartado — e justamente a baixa automática de
  // mensalidade, que ninguém vê acontecer, ficava sem rastro.
  usuarioId Int?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  // De onde partiu, quando não foi uma pessoa: "webhook:MERCADO_PAGO".
  origemSistema String?

  entidade   String // ex.: "Mensalidade"
  entidadeId Int
  operacao   String // CRIACAO | ATUALIZACAO | CANCELAMENTO | ESTORNO | PAGAMENTO | EXCLUSAO

  valoresAntes  Json?
  valoresDepois Json?

  // de onde partiu a ação — exigido pelo requisito de auditoria e útil
  // pra investigar acesso indevido. Nulos quando a operação não veio de
  // uma requisição HTTP (cron, script de manutenção).
  ip          String?
  dispositivo String?

  createdAt DateTime @default(now())

  @@index([entidade, entidadeId])
}

model Mensalidade {
  id Int @id @default(autoincrement())

  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  valor         Float
  vencimento    DateTime
  dataPagamento DateTime?
  pago          Boolean   @default(false)
  descricao     String?

  status StatusMensalidade @default(ABERTA)

  formaPagamentoId Int?
  formaPagamento   FormaPagamento? @relation(fields: [formaPagamentoId], references: [id])

  // valor original informado no cadastro; desconto/acrescimo/multa/juros
  // ajustam esse valor; valorFinal é o resultado já calculado e persistido
  // (recalculado a cada atualização) — evita recalcular na leitura toda hora.
  valorOriginal Float @default(0)
  desconto      Float @default(0)
  acrescimo     Float @default(0)
  multa         Float @default(0)
  juros         Float @default(0)
  valorFinal    Float @default(0)

  comprovanteUrl String?

  dataGeracao DateTime @default(now())

  canceladoEm        DateTime?
  motivoCancelamento String?

  estornadoEm   DateTime?
  motivoEstorno String?

  // preenchido só quando a mensalidade foi gerada automaticamente por uma
  // cobrança recorrente (ver GerarCobrancasRecorrentesService) — nulo pra
  // mensalidades avulsas, cadastradas manualmente.
  assinaturaId Int?
  assinatura   Assinatura? @relation(fields: [assinaturaId], references: [id])

  alunoId Int
  aluno   Aluno @relation(fields: [alunoId], references: [id])

  cobrancas CobrancaPagamento[]
}

// Cada chamada a um gateway gera uma tentativa persistida. O registro existe
// antes da chamada externa para que timeout, recusa e retentativa também
// apareçam na conciliação, não apenas pagamentos que chegaram por webhook.
model CobrancaPagamento {
  id Int @id @default(autoincrement())

  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  mensalidadeId Int?
  mensalidade   Mensalidade? @relation(fields: [mensalidadeId], references: [id])

  pedidoId Int?
  pedido   Pedido? @relation(fields: [pedidoId], references: [id])

  formaPagamentoId Int?
  formaPagamento   FormaPagamento? @relation(fields: [formaPagamentoId], references: [id])

  gateway           String
  gatewayId         String?
  chaveIdempotencia String  @unique
  status            String  @default("CRIANDO")

  linkPagamento   String?
  pixCopiaECola   String?
  pixQrCodeBase64 String?
  expiraEm        DateTime?

  numeroTentativa Int       @default(1)
  erro            String?
  consultadoEm    DateTime?
  reconciliadoEm  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([gateway, gatewayId])
  @@index([unidadeId, status])
  @@index([mensalidadeId, createdAt])
  @@index([pedidoId, createdAt])
}

// Configuração de cobrança recorrente de um aluno — o motor de geração
// automática (GerarCobrancasRecorrentesService) cria, periodicamente, a
// Mensalidade do mês seguinte pra cada assinatura ATIVA, respeitando
// dataFim/numeroParcelas. O desconto por pontualidade é aplicado só no
// momento do pagamento (ver PagarMensalidadeService), não na geração.
model Assinatura {
  id Int @id @default(autoincrement())

  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  alunoId Int
  aluno   Aluno @relation(fields: [alunoId], references: [id])

  planoId Int?
  plano   Plano? @relation(fields: [planoId], references: [id])

  formaPagamentoId Int?
  formaPagamento   FormaPagamento? @relation(fields: [formaPagamentoId], references: [id])

  valor         Float
  diaVencimento Int

  dataInicio DateTime
  dataFim    DateTime?

  // quando indeterminado=false, a geração para sozinha ao atingir
  // numeroParcelas (parcelasGeradas conta quantas mensalidades já saíram
  // desta assinatura); quando true, numeroParcelas é ignorado.
  indeterminado   Boolean @default(true)
  numeroParcelas  Int?
  parcelasGeradas Int     @default(0)

  desconto             Float @default(0)
  acrescimo            Float @default(0)
  multa                Float @default(0)
  juros                Float @default(0)
  descontoPontualidade Float @default(0)

  status StatusAssinatura @default(ATIVA)

  ultimaCobrancaGeradaEm DateTime?

  gatewayAssinaturaId String?
  gatewayStatus       String?
  linkAutorizacao     String?
  gatewayAtualizadoEm DateTime?

  mensalidades Mensalidade[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// Modelo de texto de contrato, com variáveis dinâmicas ({{nomeAluno}},
// {{nomeResponsavel}}, {{cpf}}, {{endereco}}, {{unidade}}, {{professor}},
// {{plano}}, {{valor}}, {{vencimento}}, {{data}}, entre outras — ver
// src/modules/contratos/utils/variaveisContrato.ts). "Versionamento" é
// modelado como uma cadeia: editar um modelo ativo cria uma nova linha
// apontando modeloOrigemId pro modelo anterior (o modelo antigo não é
// sobrescrito, então contratos já gerados a partir dele continuam
// referenciando a versão que usaram). "Clonagem" cria uma cópia
// independente (sem modeloOrigemId), pronta pra virar um modelo novo.
model ModeloContrato {
  id Int @id @default(autoincrement())

  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  nome     String
  conteudo String

  versao Int     @default(1)
  ativo  Boolean @default(true)

  modeloOrigemId Int?
  modeloOrigem   ModeloContrato?  @relation("VersoesModeloContrato", fields: [modeloOrigemId], references: [id])
  versoes        ModeloContrato[] @relation("VersoesModeloContrato")

  contratos Contrato[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// Contrato vinculado à matrícula do aluno. Quando o aluno é menor de
// idade (Aluno.dataNascimento), o contratante é obrigatoriamente um
// Responsavel (contratanteResponsavelId preenchido) — ver
// determinarContratante() em CreateContratoService; quando maior, o
// próprio aluno é o contratante e contratanteResponsavelId fica nulo.
// `conteudoGerado` é um snapshot do texto do ModeloContrato já com as
// variáveis substituídas no momento da geração — edições posteriores no
// modelo não afetam contratos já emitidos.
model Contrato {
  id Int @id @default(autoincrement())

  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  // sequencial por unidade (não é o id do banco) — ver
  // CreateContratoService para o cálculo.
  numero Int

  alunoId Int
  aluno   Aluno @relation(fields: [alunoId], references: [id])

  contratanteResponsavelId Int?
  contratanteResponsavel   Responsavel? @relation(fields: [contratanteResponsavelId], references: [id])

  modeloContratoId Int
  modeloContrato   ModeloContrato @relation(fields: [modeloContratoId], references: [id])

  planoId Int?
  plano   Plano? @relation(fields: [planoId], references: [id])

  formaPagamentoId Int?
  formaPagamento   FormaPagamento? @relation(fields: [formaPagamentoId], references: [id])

  valor Float

  dataInicioVigencia DateTime
  dataFimVigencia    DateTime?

  regrasCancelamento String?
  clausulas          String?

  conteudoGerado String

  situacao SituacaoContrato @default(RASCUNHO)

  tipoAssinatura      TipoAssinaturaContrato?
  assinadoEm          DateTime?
  contratoAssinadoUrl String?

  // quando true, RenovarContratosVencidosService (disparo externo/cron)
  // gera automaticamente o contrato seguinte ao fim da vigência; quando
  // false, a renovação só acontece por ação manual (RenovarContratoService).
  renovacaoAutomatica Boolean @default(false)

  contratoAnteriorId Int?
  contratoAnterior   Contrato?  @relation("RenovacaoContrato", fields: [contratoAnteriorId], references: [id])
  renovacoes         Contrato[] @relation("RenovacaoContrato")

  canceladoEm        DateTime?
  motivoCancelamento String?

  encerradoEm DateTime?

  solicitacoesAssinatura SolicitacaoAssinatura[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([unidadeId, numero])
}

enum TipoConsentimento {
  TRATAMENTO_DADOS
  USO_IMAGEM
  BIOMETRIA
  DADOS_SAUDE
  COMUNICACOES
}

model Consentimento {
  id Int @id @default(autoincrement())

  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  alunoId Int
  aluno   Aluno @relation(fields: [alunoId], references: [id])

  tipo TipoConsentimento

  // Quem de fato consentiu. Para menor de idade é o responsável — a LGPD
  // exige consentimento específico dado por ele (art. 14, §1º), então
  // guardar só "o aluno consentiu" não serviria como prova.
  responsavelId Int?
  responsavel   Responsavel? @relation(fields: [responsavelId], references: [id])

  concedido Boolean

  // Versão do texto aceito. Sem isso não dá pra saber A QUE a pessoa
  // consentiu quando a política mudar.
  versaoPolitica String
  textoAceito    String?

  // Quem registrou no sistema (recepção, admin) — diferente de quem
  // consentiu.
  registradoPorId Int?
  registradoPor   Usuario? @relation("ConsentimentoRegistrador", fields: [registradoPorId], references: [id])

  ip          String?
  dispositivo String?

  observacao String?

  // Consentimento é revogável a qualquer tempo (art. 8º, §5º). A linha
  // não é apagada: revogar é um fato que também precisa ficar registrado.
  revogadoEm    DateTime?
  revogadoPorId Int?
  revogadoPor   Usuario?  @relation("ConsentimentoRevogador", fields: [revogadoPorId], references: [id])

  createdAt DateTime @default(now())

  @@index([alunoId, tipo])
}

