model ConversaMensageria {
  id                Int                      @id @default(autoincrement())
  unidadeId         Int
  unidade           Unidade                  @relation(fields: [unidadeId], references: [id])
  canalMensageriaId Int
  canalMensageria   CanalMensageria          @relation(fields: [canalMensageriaId], references: [id])
  leadId            Int?
  lead              Lead?                    @relation(fields: [leadId], references: [id])
  alunoId           Int?
  aluno             Aluno?                   @relation(fields: [alunoId], references: [id])
  contatoExternoId  String
  contatoNome       String?
  estado            EstadoConversaMensageria @default(ABERTA)
  atendenteId       Int?
  atendente         Usuario?                 @relation("ConversaAtendente", fields: [atendenteId], references: [id])
  naoLidas          Int                      @default(0)
  ultimaMensagemEm  DateTime?
  mensagens         MensagemMensageria[]
  sessoesBot        BotSessao[]
  criadoEm          DateTime                 @default(now())
  atualizadoEm      DateTime                 @default(now()) @updatedAt

  @@unique([canalMensageriaId, contatoExternoId])
  @@index([unidadeId, estado, ultimaMensagemEm])
}

model MensagemMensageria {
  id                      Int                       @id @default(autoincrement())
  conversaId              Int
  conversa                ConversaMensageria        @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  canalMensageriaId       Int
  canalMensageria         CanalMensageria           @relation(fields: [canalMensageriaId], references: [id])
  mensagemExternaId       String
  provedorMensagemId      String?
  direcao                 DirecaoMensagemMensageria
  autor                   AutorMensagemMensageria
  usuarioId               Int?
  usuario                 Usuario?                  @relation(fields: [usuarioId], references: [id])
  conteudo                String?
  tipoConteudo            TipoConteudoMensageria    @default(TEXTO)
  payload                 Json?
  mediaExternaId          String?
  mediaUrlOrigem          String?
  mediaStatus             String?
  arquivoUrl              String?
  arquivoMime             String?
  arquivoNome             String?
  arquivoTamanho          Int?
  erroMedia               String?
  tentativasMedia         Int                       @default(0)
  proximaTentativaMediaEm DateTime?
  statusEntrega           StatusEntregaMensageria   @default(RECEBIDA)
  erroEnvio               String?
  tentativasEnvio         Int                       @default(0)
  proximaTentativaEm      DateTime?
  enviadaEm               DateTime
  criadoEm                DateTime                  @default(now())

  @@unique([canalMensageriaId, mensagemExternaId])
  @@index([conversaId, enviadaEm])
  @@index([provedorMensagemId])
  @@index([mediaStatus, proximaTentativaMediaEm, criadoEm])
  @@index([statusEntrega, proximaTentativaEm, criadoEm])
}

model TemplateMensageria {
  id                   Int             @id @default(autoincrement())
  unidadeId            Int
  unidade              Unidade         @relation(fields: [unidadeId], references: [id])
  canalMensageriaId    Int
  canalMensageria      CanalMensageria @relation(fields: [canalMensageriaId], references: [id], onDelete: Cascade)
  nome                 String
  idioma               String          @default("pt_BR")
  textoExibicao        String
  identificadorMeta    String?
  status               String          @default("LOCAL")
  categoria            String?
  componentes          Json?
  quantidadeParametros Int             @default(0)
  suportado            Boolean         @default(true)
  sincronizadoEm       DateTime?
  ativo                Boolean         @default(true)
  criadoEm             DateTime        @default(now())
  atualizadoEm         DateTime        @default(now()) @updatedAt

  @@unique([canalMensageriaId, nome, idioma])
  @@unique([canalMensageriaId, identificadorMeta])
  @@index([unidadeId, ativo])
}

model EventoMensageriaEntrada {
  id                 Int                           @id @default(autoincrement())
  canalMensageriaId  Int
  canalMensageria    CanalMensageria               @relation(fields: [canalMensageriaId], references: [id])
  eventoExternoId    String
  payload            Json
  status             StatusEventoMensageriaEntrada @default(PENDENTE)
  tentativas         Int                           @default(0)
  proximaTentativaEm DateTime?
  erro               String?
  processadoEm       DateTime?
  criadoEm           DateTime                      @default(now())
  atualizadoEm       DateTime                      @default(now()) @updatedAt

  @@unique([canalMensageriaId, eventoExternoId])
  @@index([status, proximaTentativaEm, criadoEm])
}

model BotFluxo {
  id           Int         @id @default(autoincrement())
  unidadeId    Int
  unidade      Unidade     @relation(fields: [unidadeId], references: [id])
  nome         String
  versao       String
  ativo        Boolean     @default(true)
  passos       Json
  sessoes      BotSessao[]
  criadoEm     DateTime    @default(now())
  atualizadoEm DateTime    @default(now()) @updatedAt

  @@unique([unidadeId, nome, versao])
  @@index([unidadeId, ativo])
}

model BotSessao {
  id           Int                @id @default(autoincrement())
  conversaId   Int
  conversa     ConversaMensageria @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  botFluxoId   Int
  botFluxo     BotFluxo           @relation(fields: [botFluxoId], references: [id])
  passoAtual   String
  respostas    Json
  expiraEm     DateTime
  lembreteEm   DateTime?
  finalizadoEm DateTime?
  criadoEm     DateTime           @default(now())
  atualizadoEm DateTime           @default(now()) @updatedAt

  @@index([conversaId, finalizadoEm])
  @@index([expiraEm, finalizadoEm])
}

model LeadEvento {
  id Int @id @default(autoincrement())

