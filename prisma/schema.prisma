// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AulaStatus {
  ABERTA
  FINALIZADA
}

// O frontend hoje calcula um status equivalente no cliente
// (mensalidades/utils/status.ts) usando o rótulo "PENDENTE" pra
// "ainda não paga, dentro do prazo" — aqui esse mesmo estado se chama
// ABERTA (nome mais preciso pro dado agora persistido no banco); o
// frontend passa a mapear ABERTA -> "PENDENTE" na exibição, sem quebrar a
// UI existente.
enum StatusMensalidade {
  ABERTA
  PAGA
  VENCIDA
  CANCELADA
  ESTORNADA
}

// Os 10 tipos pedidos pelo produto + OUTRO (forma configurável pelo
// administrador, com nome livre em FormaPagamento.nomePersonalizado).
enum TipoFormaPagamento {
  PIX
  PIX_RECORRENTE
  CARTAO_CREDITO_VISTA
  CARTAO_CREDITO_PARCELADO
  CARTAO_CREDITO_RECORRENTE
  CARTAO_DEBITO
  TRANSFERENCIA
  DINHEIRO
  BOLETO
  LINK_PAGAMENTO
  OUTRO
}

enum StatusAssinatura {
  ATIVA
  PAUSADA
  CANCELADA
  CONCLUIDA
}

// Os 8 estados pedidos pelo produto para o ciclo de vida do contrato.
enum SituacaoContrato {
  RASCUNHO
  PENDENTE_ASSINATURA
  ASSINADO
  ATIVO
  SUSPENSO
  CANCELADO
  ENCERRADO
  RENOVADO
}

enum TipoAssinaturaContrato {
  DIGITAL
  ELETRONICA
  PRESENCIAL
}

// Categorias fixas do catálogo da loja — lista fechada pedida pelo produto.
enum CategoriaProduto {
  KIMONO
  RASHGUARD
  BERMUDA
  FAIXA
  PATCH
  CHAVEIRO
  PULSEIRA
  OUTROS
}

enum TipoMovimentacaoEstoque {
  ENTRADA
  SAIDA
}

model Unidade {
  id Int @id @default(autoincrement())

  nome  String
  ativo Boolean @default(true)

  arenas           Arena[]
  modalidades      Modalidade[]
  usuarios         Usuario[]
  alunos           Aluno[]
  responsaveis     Responsavel[]
  turmas           Turma[]
  planos           Plano[]
  curriculos       Curriculo[]
  tecnicas         Tecnica[]
  competicoes      Competicao[]
  mensalidades     Mensalidade[]
  graduacoes       Graduacao[]
  aulasProgramadas AulaProgramada[]
  aulas            Aula[]
  vinculosUsuarios UsuarioUnidade[]
  metas            Meta[]
  eventos          Evento[]
  formasPagamento  FormaPagamento[]
  auditLogs        AuditLog[]
  assinaturas      Assinatura[]
  modelosContrato  ModeloContrato[]
  contratos        Contrato[]
  mensagensFamilia MensagemFamilia[]
  produtos         Produto[]
  pedidos          Pedido[]
  leads            Lead[]
  consentimentos   Consentimento[]

  createdAt DateTime @default(now())

  dispositivosAcesso DispositivoAcesso[]
  eventosAcesso      EventoAcesso[]
}

// qualquer sala, tatame ou área usada pra ministrar aulas — uma unidade
// tem uma ou mais arenas.
model Arena {
  id Int @id @default(autoincrement())

  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  nome  String
  ativo Boolean @default(true)

  turmas Turma[]

  createdAt DateTime @default(now())
}

model Aluno {
  id Int @id @default(autoincrement())

  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  nome           String
  apelido        String?
  dataNascimento DateTime

  sexo String?
  cpf  String?
  rg   String?

  telefone String?
  whatsapp String?
  email    String?

  // credencial do Portal da Família pra login direto do aluno (perfil
  // ALUNO) — mesma lógica de senhaPortal do Responsavel.
  senhaPortal String?

  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  uf          String?

  escola       String?
  serieEscolar String?
  turnoEscolar String?

  peso   Float?
  altura Float?

  tamanhoKimono String?
  marcaKimono   String?

  restricoesMedicas String?
  alergias          String?
  medicamentos      String?
  observacoes       String?

  fotoUrl String?

  faixa String  @default("Branca")
  grau  Int     @default(0)
  ativo Boolean @default(true)

  // consentimento de imagem — controla se fotos de treino em que o aluno
  // aparece podem ser marcadas como visíveis na landing pública (a
  // exibição privada no Portal da Família, restrita à própria família,
  // não depende disso).
  autorizaUsoImagem Boolean @default(true)

  responsaveis     Responsavel[]
  mensalidades     Mensalidade[]
  assinaturas      Assinatura[]
  graduacoes       Graduacao[]
  aulas            AulaAluno[]
  competicoes      CompeticaoAluno[]
  comportamentos   Comportamento[]
  contratos        Contrato[]
  mensagensFamilia MensagemFamilia[]
  pedidos          Pedido[]
  notasAula        NotaAula[]

  turmaId Int?
  turma   Turma? @relation(fields: [turmaId], references: [id])

  formaPagamento String?
  diaVencimento  Int?

  planoId Int?
  plano   Plano? @relation(fields: [planoId], references: [id])

  createdAt DateTime @default(now())
  //updatedAt         DateTime         @updatedAt
  updatedAt DateTime @default(now()) @updatedAt

  credenciaisAcesso CredencialAcesso[]
  eventosAcesso     EventoAcesso[]
  consentimentos    Consentimento[]
}

model Responsavel {
  id Int @id @default(autoincrement())

  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  nome    String
  apelido String?

  cpf            String?
  rg             String?
  dataNascimento DateTime?
  sexo           String?

  telefone String?
  whatsapp String?
  email    String?

  // credencial do Portal da Família — null enquanto o Admin não define uma
  // senha inicial (ver SetSenhaPortalResponsavelService); sem isso o
  // responsável não consegue logar no portal.
  senhaPortal String?

  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  uf          String?

  parentesco String @default("Não informado")

  responsavelFinanceiro Boolean @default(false)
  podeBuscar            Boolean @default(true)
  contatoEmergencia     Boolean @default(false)
  recebeComunicados     Boolean @default(true)

  observacoes String?
  fotoUrl     String?

  ativo Boolean @default(true)

  alunoId Int
  aluno   Aluno @relation(fields: [alunoId], references: [id])

  contratosComoContratante Contrato[]
  consentimentos           Consentimento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// forma de pagamento configurável por unidade — habilita/desabilita os
// tipos suportados e guarda parâmetros específicos do gateway em
// `configuracao` (ex.: dias de compensação do boleto). `nomePersonalizado`
// só é usado quando `tipo === OUTRO`.
model FormaPagamento {
  id Int @id @default(autoincrement())

  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  tipo              TipoFormaPagamento
  nomePersonalizado String?
  ativo             Boolean            @default(true)
  configuracao      Json?

  mensalidades Mensalidade[]
  assinaturas  Assinatura[]
  contratos    Contrato[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// Auditoria genérica de alterações financeiras e contratuais — quem fez,
// quando, o que mudou. Reaproveitada por qualquer módulo de escrita
// sensível (hoje: Mensalidade; nas próximas fases: Contrato, Assinatura).
model AuditLog {
  id Int @id @default(autoincrement())

  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  entidade   String // ex.: "Mensalidade"
  entidadeId Int
  operacao   String // CRIACAO | ATUALIZACAO | CANCELAMENTO | ESTORNO | PAGAMENTO | EXCLUSAO

  valoresAntes  Json?
  valoresDepois Json?

  // de onde partiu a ação — exigido pelo requisito de auditoria e útil
  // pra investigar acesso indevido. Nulos quando a operação não veio de
  // uma requisição HTTP (cron, script de manutenção).
  ip          String?
  dispositivo String?

  createdAt DateTime @default(now())

  @@index([entidade, entidadeId])
}

model Mensalidade {
  id Int @id @default(autoincrement())

  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  valor         Float
  vencimento    DateTime
  dataPagamento DateTime?
  pago          Boolean   @default(false)
  descricao     String?

  status StatusMensalidade @default(ABERTA)

  formaPagamentoId Int?
  formaPagamento   FormaPagamento? @relation(fields: [formaPagamentoId], references: [id])

  // valor original informado no cadastro; desconto/acrescimo/multa/juros
  // ajustam esse valor; valorFinal é o resultado já calculado e persistido
  // (recalculado a cada atualização) — evita recalcular na leitura toda hora.
  valorOriginal Float @default(0)
  desconto      Float @default(0)
  acrescimo     Float @default(0)
  multa         Float @default(0)
  juros         Float @default(0)
  valorFinal    Float @default(0)

  comprovanteUrl String?

  dataGeracao DateTime @default(now())

  canceladoEm        DateTime?
  motivoCancelamento String?

  estornadoEm   DateTime?
  motivoEstorno String?

  // preenchido só quando a mensalidade foi gerada automaticamente por uma
  // cobrança recorrente (ver GerarCobrancasRecorrentesService) — nulo pra
  // mensalidades avulsas, cadastradas manualmente.
  assinaturaId Int?
  assinatura   Assinatura? @relation(fields: [assinaturaId], references: [id])

  alunoId Int
  aluno   Aluno @relation(fields: [alunoId], references: [id])
}

// Configuração de cobrança recorrente de um aluno — o motor de geração
// automática (GerarCobrancasRecorrentesService) cria, periodicamente, a
// Mensalidade do mês seguinte pra cada assinatura ATIVA, respeitando
// dataFim/numeroParcelas. O desconto por pontualidade é aplicado só no
// momento do pagamento (ver PagarMensalidadeService), não na geração.
model Assinatura {
  id Int @id @default(autoincrement())

  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  alunoId Int
  aluno   Aluno @relation(fields: [alunoId], references: [id])

  planoId Int?
  plano   Plano? @relation(fields: [planoId], references: [id])

  formaPagamentoId Int?
  formaPagamento   FormaPagamento? @relation(fields: [formaPagamentoId], references: [id])

  valor         Float
  diaVencimento Int

  dataInicio DateTime
  dataFim    DateTime?

  // quando indeterminado=false, a geração para sozinha ao atingir
  // numeroParcelas (parcelasGeradas conta quantas mensalidades já saíram
  // desta assinatura); quando true, numeroParcelas é ignorado.
  indeterminado   Boolean @default(true)
  numeroParcelas  Int?
  parcelasGeradas Int     @default(0)

  desconto             Float @default(0)
  acrescimo            Float @default(0)
  multa                Float @default(0)
  juros                Float @default(0)
  descontoPontualidade Float @default(0)

  status StatusAssinatura @default(ATIVA)

  ultimaCobrancaGeradaEm DateTime?

  mensalidades Mensalidade[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// Modelo de texto de contrato, com variáveis dinâmicas ({{nomeAluno}},
// {{nomeResponsavel}}, {{cpf}}, {{endereco}}, {{unidade}}, {{professor}},
// {{plano}}, {{valor}}, {{vencimento}}, {{data}}, entre outras — ver
// src/modules/contratos/utils/variaveisContrato.ts). "Versionamento" é
// modelado como uma cadeia: editar um modelo ativo cria uma nova linha
// apontando modeloOrigemId pro modelo anterior (o modelo antigo não é
// sobrescrito, então contratos já gerados a partir dele continuam
// referenciando a versão que usaram). "Clonagem" cria uma cópia
// independente (sem modeloOrigemId), pronta pra virar um modelo novo.
model ModeloContrato {
  id Int @id @default(autoincrement())

  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  nome     String
  conteudo String

  versao Int     @default(1)
  ativo  Boolean @default(true)

  modeloOrigemId Int?
  modeloOrigem   ModeloContrato?  @relation("VersoesModeloContrato", fields: [modeloOrigemId], references: [id])
  versoes        ModeloContrato[] @relation("VersoesModeloContrato")

  contratos Contrato[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// Contrato vinculado à matrícula do aluno. Quando o aluno é menor de
// idade (Aluno.dataNascimento), o contratante é obrigatoriamente um
// Responsavel (contratanteResponsavelId preenchido) — ver
// determinarContratante() em CreateContratoService; quando maior, o
// próprio aluno é o contratante e contratanteResponsavelId fica nulo.
// `conteudoGerado` é um snapshot do texto do ModeloContrato já com as
// variáveis substituídas no momento da geração — edições posteriores no
// modelo não afetam contratos já emitidos.
model Contrato {
  id Int @id @default(autoincrement())

  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  // sequencial por unidade (não é o id do banco) — ver
  // CreateContratoService para o cálculo.
  numero Int

  alunoId Int
  aluno   Aluno @relation(fields: [alunoId], references: [id])

  contratanteResponsavelId Int?
  contratanteResponsavel   Responsavel? @relation(fields: [contratanteResponsavelId], references: [id])

  modeloContratoId Int
  modeloContrato   ModeloContrato @relation(fields: [modeloContratoId], references: [id])

  planoId Int?
  plano   Plano? @relation(fields: [planoId], references: [id])

  formaPagamentoId Int?
  formaPagamento   FormaPagamento? @relation(fields: [formaPagamentoId], references: [id])

  valor Float

  dataInicioVigencia DateTime
  dataFimVigencia    DateTime?

  regrasCancelamento String?
  clausulas          String?

  conteudoGerado String

  situacao SituacaoContrato @default(RASCUNHO)

  tipoAssinatura      TipoAssinaturaContrato?
  assinadoEm          DateTime?
  contratoAssinadoUrl String?

  // quando true, RenovarContratosVencidosService (disparo externo/cron)
  // gera automaticamente o contrato seguinte ao fim da vigência; quando
  // false, a renovação só acontece por ação manual (RenovarContratoService).
  renovacaoAutomatica Boolean @default(false)

  contratoAnteriorId Int?
  contratoAnterior   Contrato?  @relation("RenovacaoContrato", fields: [contratoAnteriorId], references: [id])
  renovacoes         Contrato[] @relation("RenovacaoContrato")

  canceladoEm        DateTime?
  motivoCancelamento String?

  encerradoEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([unidadeId, numero])
}

enum TipoConsentimento {
  USO_IMAGEM
  BIOMETRIA
  DADOS_SAUDE
  COMUNICACOES
}

model Consentimento {
  id Int @id @default(autoincrement())

  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  alunoId Int
  aluno   Aluno @relation(fields: [alunoId], references: [id])

  tipo TipoConsentimento

  // Quem de fato consentiu. Para menor de idade é o responsável — a LGPD
  // exige consentimento específico dado por ele (art. 14, §1º), então
  // guardar só "o aluno consentiu" não serviria como prova.
  responsavelId Int?
  responsavel   Responsavel? @relation(fields: [responsavelId], references: [id])

  concedido Boolean

  // Versão do texto aceito. Sem isso não dá pra saber A QUE a pessoa
  // consentiu quando a política mudar.
  versaoPolitica String

  // Quem registrou no sistema (recepção, admin) — diferente de quem
  // consentiu.
  registradoPorId Int?
  registradoPor   Usuario? @relation("ConsentimentoRegistrador", fields: [registradoPorId], references: [id])

  ip          String?
  dispositivo String?

  observacao String?

  // Consentimento é revogável a qualquer tempo (art. 8º, §5º). A linha
  // não é apagada: revogar é um fato que também precisa ficar registrado.
  revogadoEm     DateTime?
  revogadoPorId  Int?
  revogadoPor    Usuario?  @relation("ConsentimentoRevogador", fields: [revogadoPorId], references: [id])

  createdAt DateTime @default(now())

  @@index([alunoId, tipo])
}

model Graduacao {
  id Int @id @default(autoincrement())

  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  faixa String
  data  DateTime

  alunoId Int
  aluno   Aluno @relation(fields: [alunoId], references: [id])

  // fluxo de aprovação: graduação criada pelo ADMIN entra direto como
  // "aprovada" (comportamento de sempre); uma solicitação do PROFESSOR
  // entra "pendente" e só promove o aluno (atualiza Aluno.faixa) quando o
  // ADMIN aprova.
  status     String  @default("aprovada")
  comentario String?

  solicitadoPorId Int?
  solicitadoPor   Usuario? @relation("GraduacaoSolicitante", fields: [solicitadoPorId], references: [id])

  revisadoPorId  Int?
  revisadoPor    Usuario?  @relation("GraduacaoRevisor", fields: [revisadoPorId], references: [id])
  revisadoEm     DateTime?
  motivoRejeicao String?
}

model AulaAluno {
  id Int @id @default(autoincrement())

  aulaId Int
  aula   Aula @relation(fields: [aulaId], references: [id])

  alunoId Int
  aluno   Aluno @relation(fields: [alunoId], references: [id])

  presente Boolean @default(false)

  respeito   Boolean @default(false)
  valentia   Boolean @default(false)
  esforco    Boolean @default(false)
  atencao    Boolean @default(false)
  disciplina Boolean @default(false)

  observacao String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([aulaId, alunoId])
}

// chat simples entre a família (Portal da Família) e a academia (staff),
// por aluno — cada linha é uma mensagem, `remetenteTipo` diferencia o
// lado que enviou pra renderização (bolha esquerda/direita) e pra decidir
// quem pode responder onde.
model MensagemFamilia {
  id Int @id @default(autoincrement())

  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  alunoId Int
  aluno   Aluno @relation(fields: [alunoId], references: [id])

  remetenteTipo String // "FAMILIA" | "ACADEMIA"
  remetenteNome String

  texto String

  // marcada como lida quando o outro lado da conversa abre a tela de
  // mensagens daquele aluno (ver ListMensagensFamiliaService) — alimenta
  // os badges de "mensagens não lidas" na equipe e no Portal da Família.
  lida Boolean @default(false)

  createdAt DateTime @default(now())
}

model Competicao {
  id Int @id @default(autoincrement())

  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  nome  String
  data  DateTime
  local String

  atletas CompeticaoAluno[]
}

model CompeticaoAluno {
  id Int @id @default(autoincrement())

  competicaoId Int
  alunoId      Int

  resultado String?

  competicao Competicao @relation(fields: [competicaoId], references: [id])
  aluno      Aluno      @relation(fields: [alunoId], references: [id])
}

model Comportamento {
  id Int @id @default(autoincrement())

  alunoId Int
  aluno   Aluno @relation(fields: [alunoId], references: [id])

  respeito   Int
  valentia   Int
  esforco    Int
  atencao    Int
  disciplina Int

  observacao String?

  createdAt DateTime @default(now())
}

model Turma {
  id Int @id @default(autoincrement())

  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  arenaId Int?
  arena   Arena? @relation(fields: [arenaId], references: [id])

  modalidadeId Int?
  modalidade   Modalidade? @relation(fields: [modalidadeId], references: [id])

  nome        String
  faixaEtaria String

  diasSemana    Int[]
  horarioInicio String
  horarioFim    String

  professorId Int?
  professor   Usuario? @relation(fields: [professorId], references: [id])

  limiteAlunos Int?

  ativo Boolean @default(true)

  curriculoId Int?
  curriculo   Curriculo? @relation(fields: [curriculoId], references: [id])

  alunos           Aluno[]
  aulas            Aula[]
  aulasProgramadas AulaProgramada[]

  createdAt DateTime @default(now())
}

model Usuario {
  id Int @id @default(autoincrement())

  // nulo só pra SUPERADMIN. Pros demais, é a unidade ATIVA no momento —
  // pra ADMIN/RECEPCAO vinculado a mais de uma unidade (ver
  // UsuarioUnidade), é a que ele escolheu no seletor de "unidade ativa";
  // pra quem só tem uma, é sempre a mesma.
  unidadeId Int?
  unidade   Unidade? @relation(fields: [unidadeId], references: [id])

  nome    String
  apelido String?
  email   String  @unique
  senha   String

  perfil String

  nivelGraduacao   String?
  outrasGraduacoes String?

  fotoUrl String?

  ativo Boolean @default(true)

  turmas                Turma[]
  modalidadesCoordenadas Modalidade[]      @relation("ModalidadeCoordenador")
  avisosReconhecidos    AvisoReconhecido[]
  aulasSubstituindo     AulaProgramada[]   @relation("AulaProgramadaProfessorSubstituto")
  graduacoesSolicitadas Graduacao[]        @relation("GraduacaoSolicitante")
  graduacoesRevisadas   Graduacao[]        @relation("GraduacaoRevisor")
  // unidades que esse usuário pode acessar — ADMIN e RECEPCAO podem ter
  // mais de uma (só o SUPERADMIN monta essa lista); PROFESSOR sempre tem
  // exatamente uma.
  unidadesVinculadas    UsuarioUnidade[]
  auditLogs             AuditLog[]
  consentimentosRegistrados Consentimento[] @relation("ConsentimentoRegistrador")
  consentimentosRevogados   Consentimento[] @relation("ConsentimentoRevogador")
  fotosTreinoPublicadas FotoTreino[]
  notasAulaCriadas      NotaAula[]

  createdAt DateTime @default(now())

  credenciaisAcesso CredencialAcesso[]
  eventosAcesso     EventoAcesso[]
}

// vínculo N:N entre Usuario e Unidade — permite ADMIN/RECEPCAO trabalharem
// em mais de uma unidade. Usuario.unidadeId continua sendo a unidade ATIVA
// (o que já é usado em todo o escopo do sistema); essa tabela só guarda
// quais unidades cada usuário PODE escolher como ativa.
model UsuarioUnidade {
  id Int @id @default(autoincrement())

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  createdAt DateTime @default(now())

  @@unique([usuarioId, unidadeId])
}

model AvisoReconhecido {
  id Int @id @default(autoincrement())

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  tipo         String
  referenciaId Int

  criadoEm DateTime @default(now())

  @@unique([usuarioId, tipo, referenciaId])
}

model Plano {
  id Int @id @default(autoincrement())

  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  nome          String
  valor         Float
  periodicidade String

  ativo Boolean @default(true)

  alunos      Aluno[]
  assinaturas Assinatura[]
  contratos   Contrato[]

  createdAt DateTime @default(now())
}

// Catálogo da loja (kimonos, rashguards, faixas, patches etc). Estoque
// sempre por variante (tamanho/cor), nunca no produto — um produto sem
// variantes cadastradas não tem estoque nenhum.
model Produto {
  id Int @id @default(autoincrement())

  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  nome      String
  categoria CategoriaProduto
  preco     Float
  descricao String?
  ativo     Boolean          @default(true)
  imagemUrl String?

  variantes ProdutoVariante[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model ProdutoVariante {
  id Int @id @default(autoincrement())

  produtoId Int
  produto   Produto @relation(fields: [produtoId], references: [id])

  tamanho String
  cor     String?
  estoque Int     @default(0)

  movimentacoes MovimentacaoEstoque[]
  itensPedido   ItemPedido[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// Auditoria de toda entrada/saída de estoque. Populado a partir da venda
// pelo Portal da Família (fase seguinte) — nesta fase o modelo existe mas
// ainda não é escrito por nenhum fluxo (CRUD de produto só ajusta
// ProdutoVariante.estoque diretamente).
model MovimentacaoEstoque {
  id Int @id @default(autoincrement())

  varianteId Int
  variante   ProdutoVariante @relation(fields: [varianteId], references: [id])

  tipo       TipoMovimentacaoEstoque
  quantidade Int
  motivo     String

  data DateTime @default(now())
}

enum StatusPedido {
  AGUARDANDO_RETIRADA
  ENTREGUE
  CANCELADO
}

// Pedido da Vitrine do Portal da Família — pagamento segue o mesmo gateway
// manual das mensalidades (ver PagarMensalidadeFamiliaService): o checkout
// já confirma o pedido e decrementa o estoque; "AGUARDANDO_RETIRADA" é o
// status inicial (aguardando o aluno buscar o produto na unidade).
model Pedido {
  id Int @id @default(autoincrement())

  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  alunoId Int
  aluno   Aluno @relation(fields: [alunoId], references: [id])

  total  Float
  status StatusPedido @default(AGUARDANDO_RETIRADA)

  itens ItemPedido[]

  criadoEm   DateTime  @default(now())
  entregueEm DateTime?
}

model ItemPedido {
  id Int @id @default(autoincrement())

  pedidoId Int
  pedido   Pedido @relation(fields: [pedidoId], references: [id])

  varianteId Int
  variante   ProdutoVariante @relation(fields: [varianteId], references: [id])

  quantidade    Int
  precoUnitario Float
}

enum StatusLead {
  NOVO
  CONTACTADO
  CONVERTIDO
}

// Lead captado pelo formulário da landing page pública (site institucional
// da unidade — ver src/modules/publico). Sempre criado sem autenticação,
// escopado por UNIDADE_PUBLICA_ID.
model Lead {
  id Int @id @default(autoincrement())

  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  nome      String
  contato   String
  interesse String

  status StatusLead @default(NOVO)

  criadoEm DateTime @default(now())
}

model Aula {
  id Int @id @default(autoincrement())

  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  data        DateTime
  professor   String?
  observacoes String?

  turmaId Int?
  turma   Turma? @relation(fields: [turmaId], references: [id])

  aulaCurriculoId Int?
  aulaCurriculo   AulaCurriculo?  @relation(fields: [aulaCurriculoId], references: [id])
  programacao     AulaProgramada?

  alunos AulaAluno[]

  jogosRealizados    String[]           @default([])
  tecnicasRealizadas TecnicaCurriculo[] @relation("AulaTecnicasRealizadas")

  fotos FotoTreino[]
  notas NotaAula[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  status AulaStatus @default(ABERTA)
}

// foto publicada a partir da chamada de uma aula — a legenda é gerada a
// partir do horário/dia da aula (editável antes de publicar).
// `visivelNaLanding` controla se ela também aparece na galeria pública do
// site da academia; sem isso, fica só no Portal da Família, restrita às
// famílias com presença confirmada nessa aula.
model FotoTreino {
  id Int @id @default(autoincrement())

  aulaId Int
  aula   Aula @relation(fields: [aulaId], references: [id])

  url     String
  legenda String

  publicadaPorId Int
  publicadaPor   Usuario @relation(fields: [publicadaPorId], references: [id])

  publicadaEm DateTime @default(now())

  visivelNaLanding Boolean @default(false)
}

// nota rápida sobre um aluno específico, registrada pelo professor durante
// a aula (Portal do Professor, etapa "Notas") — alimenta o prontuário do
// aluno. `tag` é uma das 4 opções rápidas do app ("Evoluiu bem", "Precisa
// atenção", "Ótima atitude", "Faltou foco"); `texto` é o complemento livre
// opcional. Ao menos um dos dois deve vir preenchido (validado no service).
model NotaAula {
  id Int @id @default(autoincrement())

  aulaId Int
  aula   Aula @relation(fields: [aulaId], references: [id])

  alunoId Int
  aluno   Aluno @relation(fields: [alunoId], references: [id])

  tag   String?
  texto String?

  criadoPorId Int
  criadoPor   Usuario @relation(fields: [criadoPorId], references: [id])

  createdAt DateTime @default(now())
}

model Tecnica {
  id Int @id @default(autoincrement())

  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  nome String

  categoria    String
  subCategoria String?

  descricao String?

  faixaMinima String?
  idadeMinima Int?

  nivel String?

  ordemCurriculo Int?

  ativa Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Modalidade {
  id Int @id @default(autoincrement())

  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  nome      String
  descricao String?

  // texto curto de público na vitrine da landing, ex.: "4 a 13 anos".
  // É livre de propósito: não é faixa etária calculável, é como a
  // academia comunica a modalidade pra quem está de fora.
  publicoAlvo String?

  // quem responde tecnicamente pela modalidade (grade, metodologia,
  // critério de graduação). Opcional: academia pequena pode não ter.
  coordenadorId Int?
  coordenador   Usuario? @relation("ModalidadeCoordenador", fields: [coordenadorId], references: [id])

  // nem toda modalidade interna vai pra vitrine — projeto social e turma
  // corporativa, por exemplo, existem no sistema sem aparecer no site.
  visivelNaLanding Boolean @default(false)

  // controla a ordem dos cards na landing; empate desempata por nome.
  ordem Int @default(0)

  ativo Boolean @default(true)

  turmas     Turma[]
  curriculos Curriculo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([unidadeId, nome])
}

model Curriculo {
  id Int @id @default(autoincrement())

  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  nome      String
  descricao String?
  publico   String  @default("Kids")

  modalidadeId Int?
  modalidade   Modalidade? @relation(fields: [modalidadeId], references: [id])

  ativo Boolean @default(true)

  modulos ModuloCurriculo[]
  turmas  Turma[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model ModuloCurriculo {
  id Int @id @default(autoincrement())

  nome      String
  descricao String?

  faixa       String?
  idadeMinima Int?
  idadeMaxima Int?

  ordem Int @default(0)

  curriculoId Int
  curriculo   Curriculo @relation(fields: [curriculoId], references: [id])

  aulas AulaCurriculo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model AulaCurriculo {
  id Int @id @default(autoincrement())

  titulo         String
  objetivo       String?
  descricao      String?
  duracaoMinutos Int?
  jogosSugeridos String?

  ordem Int @default(0)

  moduloId Int
  modulo   ModuloCurriculo @relation(fields: [moduloId], references: [id])

  tecnicas        TecnicaCurriculo[]
  aulasRealizadas Aula[]
  programacoes    AulaProgramada[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model TecnicaCurriculo {
  id Int @id @default(autoincrement())

  nome      String
  categoria String?
  descricao String?

  obrigatoria Boolean @default(true)
  ordem       Int     @default(0)

  aulaCurriculoId Int
  aulaCurriculo   AulaCurriculo @relation(fields: [aulaCurriculoId], references: [id])

  aulasQueRealizaram Aula[] @relation("AulaTecnicasRealizadas")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model AulaProgramada {
  id Int @id @default(autoincrement())

  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  turmaId Int
  turma   Turma @relation(fields: [turmaId], references: [id])

  aulaCurriculoId Int?
  aulaCurriculo   AulaCurriculo? @relation(fields: [aulaCurriculoId], references: [id])

  data        DateTime
  observacoes String?

  status String @default("PENDENTE")

  aulaId Int?  @unique
  aula   Aula? @relation(fields: [aulaId], references: [id])

  // transferência: o professor titular (turma.professor) está impedido de
  // dar essa aula específica — outro professor assume só essa ocorrência,
  // com justificativa obrigatória do impedimento.
  professorSubstitutoId Int?
  professorSubstituto   Usuario? @relation("AulaProgramadaProfessorSubstituto", fields: [professorSubstitutoId], references: [id])
  motivoTransferencia   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// Meta estratégica do gestor (receita, matrículas, alunos ativos,
// frequência, inadimplência, retenção). `valorAtual` não é armazenado —
// é sempre calculado ao vivo a partir dos dados reais (ver
// GetMetasDashboardService), pra nunca ficar desatualizado.
model Meta {
  id Int @id @default(autoincrement())

  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  nome         String
  tipo         String // RECEITA | NOVAS_MATRICULAS | ALUNOS_ATIVOS | FREQUENCIA | INADIMPLENCIA | RETENCAO
  valorMeta    Float
  formatoValor String // MOEDA | QUANTIDADE | PERCENTUAL
  dataLimite   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// Campanha de matrícula, campanha promocional/indicação, seminário,
// workshop, aulão ou competição organizada pela academia — domínio
// técnico "eventos", exibido na interface como "Campanhas e Seminários".
model Evento {
  id Int @id @default(autoincrement())

  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  titulo    String
  descricao String?
  tipo      String // CAMPANHA_MATRICULA | CAMPANHA_PROMOCIONAL | CAMPANHA_INDICACAO | SEMINARIO | WORKSHOP | AULAO | COMPETICAO | OUTRO
  status    String  @default("RASCUNHO") // RASCUNHO | AGENDADO | EM_ANDAMENTO | CONCLUIDO | CANCELADO

  dataInicio DateTime
  dataFim    DateTime?
  local      String?

  metaParticipantes        Int?
  participantesConfirmados Int?
  investimento             Float?
  receitaGerada            Float?
  responsavel              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// ===== Controle de acesso físico (catraca / leitora) =====
//
// O Sys Belt é dono do CADASTRO e das REGRAS; o equipamento é dono do
// RECONHECIMENTO. Por isso nada aqui é específico de fabricante — a marca
// entra só como `Dispositivo.provedor`, resolvido em
// src/modules/controleAcesso/providers.

enum TipoCredencialAcesso {
  FACIAL
  BIOMETRIA
  CARTAO
  QRCODE
  PIN
}

enum SentidoAcesso {
  ENTRADA
  SAIDA
}

/// Uma catraca/leitora instalada numa unidade.
model DispositivoAcesso {
  id Int @id @default(autoincrement())

  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  nome        String
  localizacao String?

  /// nome do provedor (CONTROL_ID, HENRY, ...). Nulo = liberação manual na recepção.
  provedor String?

  /// host, porta, credenciais de API do equipamento — formato livre por fabricante.
  configuracao Json?

  /// segredo compartilhado que o equipamento usa pra assinar o webhook de evento.
  segredoWebhook String?

  ativo Boolean @default(true)

  ultimoContatoEm DateTime?

  credenciais CredencialAcesso[]
  eventos     EventoAcesso[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unidadeId])
}

/// Vínculo entre uma pessoa (aluno ou usuário) e a forma como ela se
/// identifica no equipamento. O template biométrico em si NÃO é guardado
/// aqui — fica no equipamento; o sistema só referencia o id dele.
model CredencialAcesso {
  id Int @id @default(autoincrement())

  /// exatamente um dos dois é preenchido.
  alunoId Int?
  aluno   Aluno? @relation(fields: [alunoId], references: [id])

  usuarioId Int?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  dispositivoId Int?
  dispositivo   DispositivoAcesso? @relation(fields: [dispositivoId], references: [id])

  tipo TipoCredencialAcesso

  /// número do cartão / conteúdo do QR / PIN. Nulo em FACIAL e BIOMETRIA,
  /// que vivem no equipamento.
  valor String?

  /// id da pessoa dentro do equipamento, devolvido por sincronizarPessoa.
  provedorPessoaId String?

  ativo Boolean @default(true)

  validoAte DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventos EventoAcesso[]

  @@index([alunoId])
  @@index([usuarioId])
  @@index([dispositivoId])
}

/// Toda passagem (ou tentativa) pela catraca. Serve de trilha de auditoria e
/// alimenta a frequência.
model EventoAcesso {
  id Int @id @default(autoincrement())

  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  dispositivoId Int?
  dispositivo   DispositivoAcesso? @relation(fields: [dispositivoId], references: [id])

  credencialId Int?
  credencial   CredencialAcesso? @relation(fields: [credencialId], references: [id])

  alunoId Int?
  aluno   Aluno? @relation(fields: [alunoId], references: [id])

  usuarioId Int?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  sentido    SentidoAcesso @default(ENTRADA)
  autorizado Boolean

  /// por que foi negado (ou como foi liberado) — texto pronto pra tela.
  motivo String?

  ocorridoEm DateTime @default(now())

  /// id do evento no equipamento, usado pra não gravar duplicado em reenvio.
  provedorEventoId String?

  /// payload cru do fabricante, pra auditoria e depuração da integração.
  payload Json?

  createdAt DateTime @default(now())

  @@unique([dispositivoId, provedorEventoId])
  @@index([unidadeId, ocorridoEm])
  @@index([alunoId])
}
