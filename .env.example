# Copie este arquivo para ".env" e preencha os valores.
# Em produção (Netlify), configure essas mesmas variáveis em:
# Site settings > Environment variables.

# Connection string do Postgres. Para uso com Netlify Functions (serverless),
# prefira um provedor com pooling embutido (ex.: Neon, endpoint "pooled").
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"

# Conexão DIRETA (sem pooler/PgBouncer) ao mesmo banco, usada só no comando
# `prisma migrate deploy` (ver netlify.toml). No Neon, é o mesmo connection
# string do DATABASE_URL mas sem "-pooler" no hostname. Necessária porque
# migrate deploy usa uma trava de sessão (pg_advisory_lock) que não funciona
# de forma confiável através de um pooler em modo transaction — sem isso, o
# deploy pode falhar com P1002 (timeout de advisory lock) de forma
# intermitente ou recorrente. Opcional: se não definida, o build usa
# DATABASE_URL normalmente (mesmo comportamento de antes).
DIRECT_DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"

# Segredo usado para assinar os tokens JWT. Gere um valor aleatório forte,
# por exemplo: openssl rand -base64 48
JWT_SECRET="troque-por-um-valor-aleatorio-forte"
JWT_EXPIRES_IN="7d"

# Porta local (ignorado no Netlify, que gerencia isso internamente).
PORT=3333

# Origem(ns) permitidas no CORS, separadas por vírgula.
# Em produção, se o frontend for servido pelo mesmo domínio Netlify
# (via /api/* redirect), o CORS praticamente não entra em jogo — mas
# mantenha configurado para cobrir acessos diretos à function.
# Em desenvolvimento, o padrão sem essa variável já libera as portas dos
# três apps (5173 sgcl-web, 5175 sgcl-portal-familia, 5176
# sgcl-portal-professor) — só defina CORS_ORIGIN explicitamente em produção,
# ou se mudar alguma porta local. Ao publicar landing-academia/ ou
# sgcl-portal-professor, acrescente a URL de produção de cada um aqui
# (ex.: "https://sysbelt.netlify.app,https://portal-professor.netlify.app").
CORS_ORIGIN="http://localhost:5173,http://localhost:5175,http://localhost:5176"

# Id da Unidade exposta pela landing page pública (src/modules/publico) —
# o site institucional é single-tenant: sempre mostra a mesma unidade,
# sem seletor. Descubra o id em Unidades no admin.
UNIDADE_PUBLICA_ID=""

# ===== Mercado Pago =====
# Access token da aplicação (Suas integrações > sua aplicação >
# Credenciais). Use as de TESTE até validar o fluxo ponta a ponta: as de
# produção movimentam dinheiro de verdade.
MERCADO_PAGO_ACCESS_TOKEN=""

# Segredo da assinatura do webhook (Webhooks > Configurar notificação >
# revelar chave secreta). SEM ELE NENHUM WEBHOOK É ACEITO — é o que
# impede alguém que descubra a URL de dar baixa numa mensalidade sem
# pagar. A URL a cadastrar lá é:
#   https://SEU-BACKEND/pagamentos/webhook/mercado_pago
# marcando o evento "Pagamentos".
MERCADO_PAGO_WEBHOOK_SECRET=""
