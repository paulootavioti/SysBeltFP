# Copie este arquivo para ".env" e preencha os valores.
# Em produção (Netlify), configure essas mesmas variáveis em:
# Site settings > Environment variables.

# Connection string do Postgres. Para uso com Netlify Functions (serverless),
# prefira um provedor com pooling embutido (ex.: Neon, endpoint "pooled").
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"

# Conexão DIRETA (sem pooler/PgBouncer) ao mesmo banco, usada só no comando
# `prisma migrate deploy` (ver netlify.toml). No Neon, é o mesmo connection
# string do DATABASE_URL mas sem "-pooler" no hostname. Necessária porque
# migrate deploy usa uma trava de sessão (pg_advisory_lock) que não funciona
# de forma confiável através de um pooler em modo transaction — sem isso, o
# deploy pode falhar com P1002 (timeout de advisory lock) de forma
# intermitente ou recorrente. Opcional: se não definida, o build usa
# DATABASE_URL normalmente (mesmo comportamento de antes).
DIRECT_DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"

# Região do cofre que contém uma credencial pooled exclusiva por tenant.
AWS_REGION="sa-east-1"

# Ative somente após configurar diretório, domínio e cofre no deploy. Quando
# true, autenticação sem contexto tenant falha; não há fallback para DATABASE_URL.
TENANT_RESOLUTION_ENABLED="false"
TENANT_RESOLUTION_REQUIRED="false"

# Diretório backend-backend que resolve o banco exclusivo pelo hostname.
CONTROL_PLANE_URL="https://control.sysbelt.com.br"
TENANT_DIRECTORY_SECRET="gere-um-segredo-compartilhado-com-pelo-menos-32-caracteres"
TENANT_APP_BASE_DOMAIN="app.sysbelt.com.br"
TENANT_DIRECTORY_TTL_MS="30000"
TENANT_DIRECTORY_NEGATIVE_TTL_MS="5000"
TENANT_DIRECTORY_CACHE_LIMIT="500"
TENANT_PRISMA_CACHE_LIMIT="10"
TENANT_PRISMA_IDLE_MS="300000"
# Lista exata das migrations/schemas aceitos pelo código publicado.
TENANT_SCHEMA_COMPATIBLE_VERSIONS="20260813010000_aluno_unidades_permitidas"

# Segredo usado para assinar os tokens JWT. Gere um valor aleatório forte,
# por exemplo: openssl rand -base64 48
JWT_SECRET="troque-por-um-valor-aleatorio-forte"
JWT_EXPIRES_IN="7d"

# Porta local (ignorado no Netlify, que gerencia isso internamente).
PORT=3333

# Origem(ns) permitidas no CORS, separadas por vírgula.
# Em produção, se o frontend for servido pelo mesmo domínio Netlify
# (via /api/* redirect), o CORS praticamente não entra em jogo — mas
# mantenha configurado para cobrir acessos diretos à function.
# Em desenvolvimento, o padrão sem essa variável já libera as portas dos
# três apps (5173 sgcl-web, 5175 sgcl-portal-familia, 5176
# sgcl-portal-professor) — só defina CORS_ORIGIN explicitamente em produção,
# ou se mudar alguma porta local. Ao publicar landing-academia/ ou
# sgcl-portal-professor, acrescente a URL de produção de cada um aqui
# (ex.: "https://sysbelt.netlify.app,https://portal-professor.netlify.app").
CORS_ORIGIN="http://localhost:5173,http://localhost:5175,http://localhost:5176"

# Id da Unidade exposta pela landing page pública (src/modules/publico) —
# o site institucional é single-tenant: sempre mostra a mesma unidade,
# sem seletor. Descubra o id em Unidades no admin.
UNIDADE_PUBLICA_ID=""

# ===== Cofre das credenciais guardadas no banco =====
# Chave AES-256 que cifra as credenciais de gateway de cada assinante
# (FormaPagamento.configuracao). Sem ela o sistema SE RECUSA a gravar
# credencial — não existe modo "salva em texto puro por enquanto".
#
# Ela mora fora do banco de propósito: é o que faz um dump vazado do
# banco, sozinho, não valer nada. Gere a sua com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ATENÇÃO: trocar esta chave torna ilegível toda credencial já gravada.
# Para rotacionar, decifre com a antiga e regrave com a nova.
CHAVE_SEGREDOS=""

# ===== Mercado Pago (legado — uma academia por servidor) =====
# A partir da cobrança por assinante, cada academia cadastra as PRÓPRIAS
# credenciais na forma de pagamento da unidade dela, pela tela. As duas
# variáveis abaixo só existem como ponte pra instalação antiga de cliente
# único: com mais de um assinante no mesmo servidor elas devolveriam a
# credencial do cliente errado, e o sistema avisa no log quando as usa.
#
# Deixe VAZIAS numa instalação nova.
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""

# A URL de notificação a cadastrar no painel do Mercado Pago passa a ter o
# id da forma de pagamento, que é quem diz de qual assinante é a
# notificação (a assinatura ainda é conferida com o segredo daquele
# cliente — o id na URL não é segredo e não precisa ser):
#   https://SEU-BACKEND/pagamentos/webhook/mercado_pago/<id-da-forma-de-pagamento>
# marcando o evento "Pagamentos".

# ===== WhatsApp (Meta Cloud API) =====
# Deixe WHATSAPP_PROVIDER vazio até os templates serem aprovados pela
# Meta: sem ele o sistema registra o que SERIA enviado, sem mandar nada.
# Isso permite rodar a régua de cobrança inteira em homologação.
WHATSAPP_PROVIDER=""            # "META_CLOUD_API" para enviar de verdade
#
# Com esta variável VAZIA, as réguas rodam inteiras e NADA é enviado: cada
# mensagem que sairia é gravada em MensagemWhatsapp com
# provedorMensagemId começando em "simulado-". É assim que se confere o
# texto, o destinatário e a frequência antes de ligar a Meta:
#
#   SELECT template, telefone, parametros, "provedorMensagemId"
#   FROM "MensagemWhatsapp" ORDER BY id DESC LIMIT 20;
#
# Disparos das réguas (cron externo, autenticado por CRON_SECRET no
# cabeçalho x-cron-secret). Sugestão de horário, fuso de Brasília:
#
#   07:00  POST /whatsapp/lembrete-aula/cron    (aulas do dia)
#   09:00  POST /whatsapp/regua-cobranca/cron   (vencendo em 3 dias + vencidas)
#
# O aviso de entrada/saída não tem cron: dispara sozinho quando a catraca
# registra o acesso.

# Meta Business > WhatsApp > Configuração da API
WHATSAPP_ACCESS_TOKEN=""        # token permanente do usuário do sistema
WHATSAPP_PHONE_NUMBER_ID=""     # id do número remetente (não é o telefone)

# App Secret (Configurações do app > Básico). É com ele que a assinatura
# do webhook é conferida — sem ele nenhuma notificação é aceita.
WHATSAPP_APP_SECRET=""

# Token que VOCÊ inventa e repete no painel ao cadastrar o webhook; a Meta
# o devolve no GET de verificação. URL a cadastrar:
#   https://SEU-BACKEND/whatsapp/webhook
WHATSAPP_VERIFY_TOKEN=""
# Identidade e integração exclusivas deste Tenant Plane.
TENANT_KEY="uuid-fornecido-pelo-control-plane"
# Chave privada Ed25519 em PEM. Configure como segredo e nunca versione o valor real.
TENANT_INTEGRATION_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----"
# Chave pública usada para validar concessões emitidas pelo Control Plane.
CONTROL_PLANE_GRANT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----"
