# Copie para ".env.local" para desenvolvimento local, se precisar
# apontar para uma API diferente de http://localhost:3333.
#
# Em produção no Netlify (backend como Netlify Function no mesmo site),
# NÃO defina essa variável — o frontend usa "/api" automaticamente
# (same-origin, resolvido pelo redirect em netlify.toml).
# VITE_API_URL=http://localhost:3333

# URL do Portal da Família (sgcl-portal-familia), linkado na tela de
# login. Em desenvolvimento já aponta para http://localhost:5175 por
# padrão — só defina se o portal estiver em outra porta/domínio (ex.: a
# URL de produção do portal, depois de publicado).
# VITE_PORTAL_FAMILIA_URL=http://localhost:5175

# URL do Portal do Professor (sgcl-portal-professor), linkado na tela de
# login. Em desenvolvimento aponta para http://localhost:5176 por padrão.
# VITE_PORTAL_PROFESSOR_URL=http://localhost:5176
