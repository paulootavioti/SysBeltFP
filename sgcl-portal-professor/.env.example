# Copie para ".env.local" se precisar apontar para uma API diferente de
# http://localhost:3333 durante o desenvolvimento.
# VITE_API_URL=http://localhost:3333

# Em produção (Netlify), este app é publicado como um site SEPARADO do
# sgcl-web — não tem função serverless própria, então NÃO existe "/api"
# same-origin como no site principal. É OBRIGATÓRIO definir VITE_API_URL
# com a URL completa e absoluta do backend antes de fazer o build de
# produção (Site settings → Environment variables no Netlify), senão o
# app tenta chamar "/api" no próprio domínio do portal e toda requisição
# retorna 404.
# VITE_API_URL=https://sysbelt.netlify.app/api

# URL do sgcl-web (sistema completo) — os atalhos de "Preparação e análise"
# na Home abrem lá (Planejamento, Prontuários, Graduações, Minhas turmas).
# Em desenvolvimento já aponta para http://localhost:5173 por padrão.
# VITE_SGCL_WEB_URL=http://localhost:5173
